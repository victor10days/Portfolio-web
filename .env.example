# Copy to .env and fill in real values. Never commit the real .env.

# --- Admin auth ---
# Secret used to sign admin JWTs.
JWT_SECRET=YOUR_JWT_SECRET_HERE
# bcrypt hash of the admin password (generated with bcryptjs).
ADMIN_HASH=YOUR_BCRYPT_HASH_HERE
# Local API port (Render provides its own PORT in production).
PORT=3001

# --- Contact email: primary sender (Resend) ---
# API key from https://resend.com. Required for the primary email channel.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
# Verified sender. The domain must be verified in Resend.
MAIL_FROM=Portfolio <contact@tendaysmusic.com>
# Inbox that receives contact-form notifications.
MAIL_TO=you@example.com

# --- Contact email: optional Gmail fallback ---
# Used only if Resend is unconfigured or a send fails. Requires 2FA + an App
# Password on the Gmail account (a normal password will not work).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
